import { NextResponse } from "next/server";
import { z } from "zod";
import { calcFare } from "@/lib/fare";
import { rateLimit } from "@/lib/rateLimit";

const schema = z.object({
  originPlaceId: z.string().min(5).max(300),
  destPlaceId: z.string().min(5).max(300),
  car: z.enum(["sedan", "ertiga", "innova", "tempo"]),
  tripType: z.enum(["oneway", "round"]),
  days: z.number().int().min(1).max(30).optional(),
});

export async function POST(req: Request) {
  const ip = req.headers.get("x-forwarded-for") ?? "anon";
  if (!rateLimit(ip, 20, 60_000)) {
    return NextResponse.json({ error: "Too many requests" }, { status: 429 });
  }

  const parsed = schema.safeParse(await req.json());
  if (!parsed.success) return NextResponse.json({ error: "Invalid input" }, { status: 400 });
  const { originPlaceId, destPlaceId, car, tripType, days } = parsed.data;

  const res = await fetch("https://routes.googleapis.com/directions/v2:computeRoutes", {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      "X-Goog-Api-Key": process.env.GMAPS_SERVER_KEY!,
      "X-Goog-FieldMask": "routes.distanceMeters,routes.duration,routes.polyline.encodedPolyline",
    },
    body: JSON.stringify({
      origin: { placeId: originPlaceId },
      destination: { placeId: destPlaceId },
      travelMode: "DRIVE",
      routingPreference: "TRAFFIC_AWARE",
      regionCode: "IN",
    }),
  });

  if (!res.ok) return NextResponse.json({ error: "Route not found" }, { status: 502 });
  const data = await res.json();
  const route = data.routes?.[0];
  if (!route) return NextResponse.json({ error: "No route" }, { status: 404 });

  const km = Math.round((route.distanceMeters / 1000) * 10) / 10;
  const seconds = parseInt(route.duration);          // e.g. "11400s"
  const fare = calcFare(km, car, tripType, days ?? 1);

  return NextResponse.json({
    km,
    duration: `${Math.floor(seconds / 3600)}h ${Math.round((seconds % 3600) / 60)}m`,
    fare,
    polyline: route.polyline.encodedPolyline,
  });
}
