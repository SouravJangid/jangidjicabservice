lib/fare.ts
ts
import pricing from "@/content/pricing.json";

export function calcFare(distanceKm: number, car: keyof typeof pricing.rates,
  tripType: "oneway" | "round", days = 1, night = false) {
  const r = pricing.rates[car];
  let fare: number;
  if (tripType === "oneway") {
    fare = Math.max(distanceKm * r.perKm, r.minFare);
  } else {
    const billableKm = Math.max(distanceKm * 2, r.minKmPerDay * days);
    fare = billableKm * r.perKm + (days > 1 ? (days - 1) * r.driverAllowancePerNight : 0);
  }
  if (night && pricing.nightCharge.enabled) fare += pricing.nightCharge.amount;
  return Math.round(fare);
}
